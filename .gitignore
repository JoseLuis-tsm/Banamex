# Datos: nunca van a git (se conserva solo la carpeta)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Modelos: binarios fuera; metadatos .json sí se suben
models/**
!models/**/
!models/**/*.json
!models/.gitkeep

# Entorno y cachés de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
